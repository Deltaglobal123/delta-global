{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://deltaglobal-backend.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://deltaglobal-backend.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://deltaglobal-backend.onrender.com/admin/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://deltaglobal-backend.onrender.com/storage/:path*"
    },
    
    { "source": "/build/:path*", "destination": "https://deltaglobal-backend.onrender.com/build/:path*" }

  ]
}
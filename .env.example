# Full API base, including /api.
#
# With `php artisan serve` running in the backend (what this project uses):
VITE_API_URL=http://127.0.0.1:8000/api
#
# Served by XAMPP's Apache instead, the backend lives under htdocs:
# VITE_API_URL=http://localhost/deltaglobal/backend/public/api
#
# Either way, the backend's FRONTEND_URL must list this dev server's origin
# (http://localhost:5173) or the browser will block every call on CORS.

# Where staff accounts (admin / manager) are sent after login. The admin side is
# a Blade panel served by the same Laravel app, not part of this React build.
VITE_ADMIN_URL=http://127.0.0.1:8000/login
